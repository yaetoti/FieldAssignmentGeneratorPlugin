<Project Sdk="Microsoft.NET.Sdk">

  <Import Project="..\PlatformDirectory.Generated.props" />
  
  <PropertyGroup>
    <TargetFramework>net472</TargetFramework>
    <IsPackable>True</IsPackable>
    <DefineConstants>$(DefineConstants);RESHARPER</DefineConstants>
    <IncludeBuildOutput>false</IncludeBuildOutput>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="JetBrains.Rider.SDK" Version="$(SdkVersion)" PrivateAssets="all" />
    <PackageReference Include="Wave" Version="$(WaveVersion)" />
  </ItemGroup>

  <ItemGroup>
    <Content Include="..\..\..\dependencies.json" PackagePath="" Pack="true" Visible="false" />
    <Content Include="bin\$(AssemblyName)\$(Configuration)\$(AssemblyName).dll" PackagePath="dotFiles" Pack="true" Visible="false" />
    <Content Include="bin\$(AssemblyName)\$(Configuration)\$(AssemblyName).pdb" PackagePath="dotFiles" Pack="true" Visible="false" />
  </ItemGroup>
  
  <ItemGroup>
    <Reference Include="JetBrains.ReSharper.Cpp">
      <HintPath>$(PlatformDirectory)\plugins\clion-radler\DotFiles\JetBrains.ReSharper.Cpp.dll</HintPath>
    </Reference>

    <Reference Include="JetBrains.ReSharper.Feature.Services">
      <HintPath>$(PlatformDirectory)\plugins\clion-radler\DotFiles\JetBrains.ReSharper.Feature.Services.dll</HintPath>
    </Reference>
    
    <Reference Include="JetBrains.ReSharper.Feature.Services.Cpp">
      <HintPath>$(PlatformDirectory)\plugins\clion-radler\DotFiles\JetBrains.ReSharper.Feature.Services.Cpp.dll</HintPath>
    </Reference>
  </ItemGroup>

</Project>
